</main><script>
const token=<?=json_encode(csrf())?>;const page=<?=json_encode($pagina)?>;
const $=id=>document.getElementById(id);
async function post(data){const form=new FormData();for(const [k,v] of Object.entries({...data,csrf:token}))form.append(k,v);const res=await fetch(location.pathname,{method:'POST',body:form,credentials:'same-origin'});const r=await res.json();if(!r.ok)throw new Error(r.erro||'Falha inesperada');return r}
for(const id of ['setup','login'])if($(id))$(id).addEventListener('submit',async ev=>{ev.preventDefault();try{await post(Object.fromEntries(new FormData(ev.target)));location.reload()}catch(e){$('error').textContent=e.message}});
if($('logout'))$('logout').onclick=async()=>{await post({action:'logout'});location.reload()};
let stream=null,faceDetector=null,loopId=null,busy=false,photo=null,stable=0;
function stopCam(){if(loopId)clearInterval(loopId);loopId=null;if(stream)stream.getTracks().forEach(t=>t.stop());stream=null}
async function camera(){try{stopCam();stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'user'},width:{ideal:640},height:{ideal:480}},audio:false});$('video').srcObject=stream;await $('video').play();if($('cam'))$('cam').classList.remove('hidden');$('capture').classList.remove('hidden');$('status').textContent='Câmera aberta. Enquadre o rosto.';if(page==='terminal')startAuto()}catch(e){$('status').textContent='Não foi possível abrir a câmera: '+e.message+' (necessário HTTPS no celular).'}}
if($('openCam'))$('openCam').onclick=camera;
function photoData(){const v=$('video'),c=$('canvas');if(!v.videoWidth)throw new Error('Câmera ainda não está pronta.');c.width=640;c.height=Math.round(640*v.videoHeight/v.videoWidth);c.getContext('2d').drawImage(v,0,0,c.width,c.height);return c.toDataURL('image/jpeg',.82)}
if($('capture'))$('capture').onclick=()=>capture();
async function capture(){if(busy)return;busy=true;try{photo=photoData();stopCam();if(page==='terminal'){await identify(photo)}else{$('preview').src=photo;$('preview').classList.remove('hidden');$('status').textContent='Foto capturada. Salve o cadastro.'}}catch(e){$('status').textContent=e.message}finally{busy=false}}
async function startAuto(){if(!('FaceDetector' in window)){$('status').textContent='Detecção automática não disponível neste navegador. Use “Fotografar manualmente”.';return}try{faceDetector=new FaceDetector({fastMode:true,maxDetectedFaces:2})}catch(e){$('status').textContent='Use o botão manual.';return}loopId=setInterval(async()=>{if(busy||!stream)return;try{const faces=await faceDetector.detect($('video'));if(faces.length===1){stable++;$('status').textContent='Rosto detectado: mantenha a posição…';if(stable>=3){stable=0;clearInterval(loopId);loopId=null;await capture()}}else{stable=0;$('status').textContent=faces.length>1?'Somente uma pessoa na imagem.':'Centralize o rosto na câmera.'}}catch(e){clearInterval(loopId);loopId=null;$('status').textContent='Detecção automática indisponível. Use o botão manual.'}},750)}
async function identify(img){$('result').classList.add('hidden');$('status').textContent='Comparando o rosto com os cadastros…';try{const r=await post({action:'identificar',foto:img});if(r.status==='correspondencia'){$('status').textContent='Possível correspondência encontrada. Confirme antes de registrar.';$('result').innerHTML='';const title=document.createElement('h2');title.textContent=r.pessoa.nome;const company=document.createElement('p');company.textContent=r.pessoa.empresa||'';const actions=document.createElement('div');actions.className='actions';for(const kind of ['ENTRADA','SAIDA']){const b=document.createElement('button');b.textContent='Confirmar '+kind.toLowerCase();b.onclick=()=>savePresence(r.token,kind);actions.appendChild(b)}$('result').append(title,company,actions);$('result').classList.remove('hidden')}else{$('status').textContent='Não identificado: '+(r.motivo||r.status);retryButton()}}catch(e){$('status').textContent='Erro: '+e.message;retryButton()}}
function retryButton(){const b=document.createElement('button');b.textContent='Tentar novamente';b.onclick=()=>location.reload();$('result').replaceChildren(b);$('result').classList.remove('hidden')}
async function savePresence(tok,kind){try{await post({action:'presenca',token:tok,tipo:kind});$('status').textContent=kind+' registrada com sucesso.';retryButton()}catch(e){$('status').textContent=e.message}}
if($('cadastro'))$('cadastro').onsubmit=async ev=>{ev.preventDefault();if(!photo){$('status').textContent='Capture a foto antes de salvar.';return}try{const values=Object.fromEntries(new FormData(ev.target));await post({...values,foto:photo});$('status').textContent='Cadastro salvo!';photo=null;ev.target.reset();$('preview').classList.add('hidden')}catch(e){$('status').textContent='Falha ao cadastrar: '+e.message}};
</script><script>if ('serviceWorker' in navigator) { window.addEventListener('load', () => navigator.serviceWorker.register('/portaria/sw.js').catch(console.warn)); }</script></body></html>
